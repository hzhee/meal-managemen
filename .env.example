# Firebase web configuration (safe to expose; not an admin secret)
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me

# Set the following with Firebase Functions secrets; never put their values here or in GitHub:
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
# WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID
# INITIAL_OWNER_EMAIL
